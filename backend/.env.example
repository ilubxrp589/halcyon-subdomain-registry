# =============================================================
# HSR Backend Environment Configuration
# =============================================================
# SECURITY: Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!
# =============================================================

# Server
PORT=8000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/subdomain_registry

# HNS Node
HNS_HOST=127.0.0.1
HNS_PORT=12037
HNS_API_KEY=YOUR_HNS_API_KEY
HNS_WALLET_PORT=12039

# Flare Network
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_CHAIN_ID=114

# Contract Addresses (deployed contracts)
CONTRACT_NFT=0xYOUR_NFT_CONTRACT_ADDRESS
CONTRACT_ESCROW=0xYOUR_ESCROW_CONTRACT_ADDRESS
CONTRACT_DNS_ORACLE=0xYOUR_DNS_ORACLE_ADDRESS
CONTRACT_PRICE_ORACLE=0xYOUR_PRICE_ORACLE_ADDRESS
CONTRACT_MARKETPLACE=0xYOUR_MARKETPLACE_ADDRESS

# Backend Wallet (for oracle transactions)
# CRITICAL: Generate a new private key, never share or commit!
BACKEND_PRIVATE_KEY=YOUR_64_CHAR_HEX_PRIVATE_KEY

# Platform Wallet (receives fees)
PLATFORM_WALLET=0xYOUR_PLATFORM_WALLET_ADDRESS

# Treasury Address (receives credit purchases)
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS

# Admin Wallets (comma-separated, for admin API access)
ADMIN_WALLETS=0xYOUR_ADMIN_WALLET_1,0xYOUR_ADMIN_WALLET_2

# PowerDNS
PDNS_API_URL=http://127.0.0.1:8081
PDNS_API_KEY=YOUR_PDNS_API_KEY

# NFT Storage / Pinata (IPFS)
# Get JWT from https://app.pinata.cloud/developers/api-keys
NFT_STORAGE_API_KEY=YOUR_NFT_STORAGE_API_KEY
PINATA_JWT=YOUR_PINATA_JWT_TOKEN

# Image Generation Backend
# Options: 'comfyui' (recommended, uses Flux/SDXL) or 'python' (legacy, uses SD 1.5)
SD_BACKEND=comfyui

# ComfyUI Configuration (when SD_BACKEND=comfyui)
COMFYUI_FLUX_URL=http://127.0.0.1:8188
COMFYUI_SDXL_URL=http://127.0.0.1:8189
COMFYUI_MODEL=flux

# Legacy Python Stable Diffusion (when SD_BACKEND=python)
SD_MODEL_ID=runwayml/stable-diffusion-v1-5
PYTHON_CMD=/path/to/your/venv/bin/python

# Credit Purchase Pricing (in wei)
# 5 FLR = 5000000000000000000 wei
CREDIT_PURCHASE_PRICE=5000000000000000000
CREDITS_PER_PURCHASE=5
