# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Platform recipient address (receives payments)
PLATFORM_RECIPIENT=0x...

# Royalty recipient address (receives NFT royalties)
ROYALTY_RECIPIENT=0x...

# Initial FLR/USD price (in wei, e.g., 0.05 USD = 50000000000000000)
INITIAL_FLR_PRICE=50000000000000000

# Subdomain price in USD (in wei, e.g., 5 USD = 5000000000000000000)
SUBDOMAIN_PRICE_USD=5000000000000000000
