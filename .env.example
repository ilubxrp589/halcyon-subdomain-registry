# ============================================
# HSR — Halcyon Subdomain Registry
# Environment Variables Template
# Copy to backend/.env and frontend/.env.local
# ============================================

# ---- Backend (.env) ----

# Server
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:3000
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/subdomain_registry

# HNS Node
HNS_HOST=127.0.0.1
HNS_PORT=12037
HNS_API_KEY=your-hns-api-key
HNS_WALLET_PORT=12039

# Flare Network
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_CHAIN_ID=114

# Contract Addresses (Coston2)
CONTRACT_NFT=0x...
CONTRACT_ESCROW=0x...
CONTRACT_DNS_ORACLE=0x...
CONTRACT_PRICE_ORACLE=0x...
CONTRACT_MARKETPLACE=0x...

# Backend Wallet (for oracle transactions — KEEP SECRET)
BACKEND_PRIVATE_KEY=your-private-key

# Platform
PLATFORM_WALLET=0x...
TREASURY_ADDRESS=0x...

# Admin Wallets (comma-separated)
ADMIN_WALLETS=0x...

# PowerDNS
PDNS_API_URL=http://127.0.0.1:8081
PDNS_API_KEY=your-pdns-api-key
NFT_STORAGE_API_KEY=your-nft-storage-key

# Image Generation
SD_BACKEND=comfyui
COMFYUI_SCHNELL_URL=http://127.0.0.1:8188
COMFYUI_SDXL_URL=http://127.0.0.1:8189
COMFYUI_DEV_URL=http://127.0.0.1:8190
IMAGE_MODEL=sdxl-playground-lora
COMFYUI_MODEL=schnell

# IPFS (Pinata)
PINATA_JWT=your-pinata-jwt

# Redirect Server
REDIRECT_SERVER_IP=10.0.0.39
REDIRECT_PORT=8080

# Royalties
ROYALTIES_PRIVATE_KEY=your-royalties-key
ROYALTIES_ADDRESS=0x...

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (Resend)
RESEND_API_KEY=your-resend-key
EMAIL_ENABLED=false
EMAIL_BASE_URL=https://your-domain.io/api/proxy/email/unsubscribe

# Error Tracking
SENTRY_DSN=

# ---- Frontend (.env.local) ----

# API
NEXT_PUBLIC_API_URL=/api/proxy
API_URL=http://localhost:8000/api/v1
BACKEND_URL=http://localhost:8000

# Contract Addresses (must match backend)
NEXT_PUBLIC_CONTRACT_NFT=0x...
NEXT_PUBLIC_CONTRACT_ESCROW=0x...
NEXT_PUBLIC_CONTRACT_DNS_ORACLE=0x...
NEXT_PUBLIC_CONTRACT_PRICE_ORACLE=0x...
NEXT_PUBLIC_CONTRACT_MARKETPLACE=0x...
NEXT_PUBLIC_COMMUNITY_TREASURY_ADDRESS=0x...
NEXT_PUBLIC_TREASURY_ADDRESS=0x...

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# IPFS
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.io
